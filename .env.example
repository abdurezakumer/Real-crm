TELEGRAM_BOT_TOKEN=replace-with-bot-token
# Generate 32–256 varied URL-safe characters; this secret must match Telegram's webhook setting.
TELEGRAM_WEBHOOK_SECRET=replace-with-32-byte-random-secret
TELEGRAM_WEBHOOK_URL=https://your-project.vercel.app/api/webhook
# Initial bootstrap super administrator. Invite all additional CRM users through Telegram.
AUTHORIZED_TELEGRAM_USER_ID=123456789
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-only-if-private-storage-is-used
# Use sslmode=require for a remote PostgreSQL/Supabase connection.
# Copy the Shared Pooler transaction-mode URI from Supabase Connect for Vercel (port 6543).
SUPABASE_DATABASE_URL=postgresql://postgres.project-ref:password@your-pooler-host:6543/postgres?sslmode=require
APP_TIMEZONE=Africa/Addis_Ababa
MAX_IMPORT_FILE_MB=20
MAX_IMPORT_ROWS=100000
IMPORT_BATCH_SIZE=500
IMPORT_RETENTION_HOURS=24
MAX_CALL_ATTEMPTS=8
DEFAULT_DAILY_CALL_TARGET=50
# Generate at least 32 random characters; keep this separate from the Telegram webhook secret.
FOLLOW_UP_CRON_SECRET=replace-with-another-32-byte-random-secret
MAX_SEARCH_RESULTS=10
EXPORT_MAX_ROWS=50000
AI_ENABLED=false
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://api.example.com/v1
AI_API_KEY=replace-with-provider-key
AI_MODEL=administrator-selected-model
AI_REQUEST_TIMEOUT_SECONDS=25
AI_MAX_INPUT_CHARS=5000
AI_MAX_OUTPUT_CHARS=4000
AI_DAILY_REQUEST_LIMIT=20
MATCH_ALLOW_NEAR_BUDGET=false
MATCH_BUDGET_WEIGHT=35
MATCH_LOCATION_WEIGHT=25
MATCH_PROPERTY_TYPE_WEIGHT=15
MATCH_BEDROOMS_WEIGHT=10
MATCH_PAYMENT_WEIGHT=10
MATCH_TIMELINE_WEIGHT=5
LEAD_INTEREST_WEIGHT=25
LEAD_REQUIREMENTS_BUDGET_WEIGHT=20
LEAD_TIMELINE_WEIGHT=20
LEAD_ENGAGEMENT_WEIGHT=15
LEAD_NEXT_ACTION_WEIGHT=10
LEAD_RECENT_POSITIVE_WEIGHT=10
QUEUE_PRIORITY_ORDER=overdue_high,due_followup,high_qualified,qualified,interested,new,retry
